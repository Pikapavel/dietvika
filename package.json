{
  "name": "dietvika",
  "version": "0.1.0",
  "description": "DietVika — трекер порций методом рук (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/make-reminders.mjs && tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts",
    "preview": "vite preview",
    "foods": "node scripts/csv-to-foods.mjs",
    "icons": "node scripts/make-icons.mjs",
    "reminders": "node scripts/make-reminders.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-singlefile": "2.3.3"
  },
  "private": true,
  "type": "module"
}